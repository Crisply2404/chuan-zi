{
  "name": "chuan-zi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && tsx scripts/prepare-glyphs.ts && tsx scripts/prepare-glyph-font.ts && tsx scripts/prepare-public.ts && vite build && tsx scripts/check-pages-artifact.ts",
    "build:pages": "VITE_WS_URL=wss://chuan-zi-online.tcoinsm.workers.dev/ws npm run build",
    "check:pages": "tsx scripts/check-pages-artifact.ts",
    "preview": "vite preview --host 0.0.0.0",
    "data:build": "tsx scripts/build-data.ts",
    "test": "npm run cloudflare:build && tsx scripts/prepare-glyphs.ts && tsx scripts/prepare-glyph-font.ts && tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && tsc -p tsconfig.cloudflare.json --noEmit",
    "cloudflare:build": "tsx scripts/prepare-cloudflare.ts",
    "cloudflare:dev": "wrangler dev --ip 0.0.0.0 --port 8788 --persist-to .scratch/cloudflare/wrangler-state",
    "cloudflare:deploy": "wrangler deploy",
    "test:cloudflare": "npm run cloudflare:build && tsx --test tests/cloudflare.test.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.468.0",
    "pinyin-utils": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.56.0",
    "@types/adm-zip": "^0.5.7",
    "@types/jsonlines": "^0.1.5",
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "adm-zip": "^0.6.1",
    "cedict-json": "1.3.20251213",
    "fflate": "^0.8.2",
    "jsonlines": "^0.1.1",
    "miniflare": "^5.20261006.1-alpha",
    "opentype.js": "^2.0.0",
    "parse-ids": "0.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.149.0"
  }
}
